/**
 * CBT 58 Sekolah - Firebase project/group provisioning helper.
 * This script only creates a Firebase project after the operator explicitly
 * opts in with --execute, confirms account and project ID, and logs in locally.
 * The initial DEFAULT Realtime Database is initialized interactively using
 * the official `firebase init database` workflow.
 * NEVER pass private keys or passwords to this script.
 */
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import readline from 'node:readline/promises';

const root = path.resolve(import.meta.dirname, '..');
const args = process.argv.slice(2);
const accountId = args[0];
const execute = args.includes('--execute');
const flag = (name) => {
  const i=args.indexOf(name);
  return i>=0 ? args[i+1] : undefined;
};
const accounts = JSON.parse(fs.readFileSync(path.join(root,'config','accounts.json'),'utf8'));
const schools = JSON.parse(fs.readFileSync(path.join(root,'config','schools.json'),'utf8'));
const account = accounts.find(x=>x.account_id===accountId && x.role==='OPERASIONAL');
if(!account){console.error('Pakai AKUN-01 sampai AKUN-15.'); process.exit(1);}
const email=flag('--email') || account.email;
const batch=schools.filter(x=>x.account_id===accountId);
const groups=[...new Set(batch.map(x=>x.firebase_group))];
if(groups.length!==1){throw Error('Satu akun harus memiliki tepat satu grup Firebase.');}
const group=groups[0];
const groupNo=group.match(/(\d{2})$/)?.[1];
if(!groupNo){throw Error('Grup Firebase tidak valid: '+group);}
const projectId=flag('--project-id') || `cbt-grup-${groupNo}`;
if(!/^[a-z][a-z0-9-]{4,28}[a-z0-9]$/.test(projectId)){throw Error('Project ID harus 6-30 karakter lowercase/angka/hyphen dan awali huruf.');}
const groupFolder=path.join(root,'firebase-groups',group);
const run = (argv,opts={}) => {
 const p=spawnSync('firebase',argv,{encoding:'utf8',cwd:opts.cwd||root,stdio:opts.stdio||'pipe',shell:process.platform==='win32'});
 if(p.error)throw p.error;
 if(p.status!==0){
   if(opts.ignoreError)return p;
   throw Error(`Firebase CLI gagal: firebase ${argv.join(' ')}\n${p.stderr||p.stdout||''}`);
 }
 return p;
};
console.log(`\n${accountId} → ${group} → ${projectId}`);
console.log('Login Firebase yang diharapkan: '+email);
console.log('Sekolah: '+batch.map(x=>x.school_id).join(', '));
console.log('Rencana: 1 Firebase Project + 1 Realtime Database default untuk semua sekolah pada grup.');
if(!execute){console.log('\nDRY RUN. Untuk lanjut setelah login gunakan --execute.');process.exit(0);}
if(!email || email.startsWith('ISI_'))throw Error('Email akun belum diisi; gunakan --email atau config/accounts.json.');

const version=run(['--version']);
console.log('Firebase CLI: '+version.stdout.trim());
const login=run(['login:list']);
console.log(login.stdout.trim());
if(!login.stdout.toLowerCase().includes(email.toLowerCase())){
 throw Error(`Akun ${email} belum ada di Firebase CLI. Jalankan firebase login lalu firebase login:use ${email}`);
}
// Use the requested account only when it differs from the active Firebase CLI account.
// firebase login:use exits nonzero with 'Already using account' when it is already active.
const activeAccount = login.stdout.match(/Logged in as\s+(\S+)/i)?.[1];
if (activeAccount?.toLowerCase() !== email.toLowerCase()) {
  run(['login:use',email],{stdio:'inherit'});
} else {
  console.log('Akun Firebase sudah aktif: '+email);
}
const answer=readline.createInterface({input:process.stdin,output:process.stdout});
const typed=await answer.question(`Buat/lanjutkan project '${projectId}' sebagai ${email}? Ketik '${group}' untuk lanjut: `);
answer.close();
if(typed!==group){console.error('Dibatalkan.');process.exit(1);}

let exists=false;
const projects=run(['projects:list','--json']);
try{
 const parsed=JSON.parse(projects.stdout);
 const list=Array.isArray(parsed.result)?parsed.result:Array.isArray(parsed.result?.projects)?parsed.result.projects:[];
 exists=list.some(x=>x.projectId===projectId || x.project_id===projectId);
}catch(e){throw Error('Tidak bisa membaca JSON project dari Firebase CLI: '+e.message);}
if(exists){
 console.log(`Project ${projectId} sudah tersedia pada akun ini. Tidak dibuat ulang.`);
}else{
 console.log('Membuat Firebase project '+projectId+' ...');
 run(['projects:create',projectId,'--display-name',`CBT GRUP ${groupNo}`,'--non-interactive'],{stdio:'inherit'});
}

fs.mkdirSync(groupFolder,{recursive:true});
// `database:instances:create` cannot create the initial default database.
// The official first-time workflow `firebase init database` can prompt for location/rules.
console.log('\nMenyiapkan Realtime Database default. Ikuti dialog CLI dan pilih region asia-southeast1 jika tersedia.');
console.log('Jika ditanya rules, gunakan nama database.rules.json dan LOCKED MODE (tidak terbuka publik).');
run(['init','database','--project',projectId],{cwd:groupFolder,stdio:'inherit'});

// Lock public client reads and writes. Apps Script service account access is server-side.
const rulesFile=path.join(groupFolder,'database.rules.json');
fs.writeFileSync(rulesFile,JSON.stringify({rules:{'.read':false,'.write':false}},null,2)+'\n');
const configFile=path.join(groupFolder,'firebase.json');
const firebaseConfig=fs.existsSync(configFile)?JSON.parse(fs.readFileSync(configFile,'utf8')):{};
firebaseConfig.database={rules:'database.rules.json'};
fs.writeFileSync(configFile,JSON.stringify(firebaseConfig,null,2)+'\n');
console.log('Deploy Realtime Database Rules: baca/tulis publik DITUTUP.');
run(['deploy','--only','database','--project',projectId,'--non-interactive'],{cwd:groupFolder,stdio:'inherit'});

// Verify database listing. No guesses about its actual URL.
const instances=run(['database:instances:list','--project',projectId],{ignoreError:true});
console.log('\nDATABASE INSTANCES:');
console.log((instances.stdout||instances.stderr||'').trim()||'(Tidak ada output)');
if(instances.status!==0){
 console.log('Database belum berhasil diverifikasi. Periksa Firebase Console dan ulangi inisialisasi jika perlu.');
 process.exit(2);
}
const summary={account_id:accountId,account_email:email,group,project_id:projectId,schools:batch.map(x=>x.school_id),created_or_found_at:new Date().toISOString(),database_status:'VERIFY_IN_CONSOLE',database_url:'',notes:'Salin URL RTDB aktual dari Firebase Console. Jangan simpan kredensial service account di repo.'};
fs.writeFileSync(path.join(groupFolder,'provision-result.json'),JSON.stringify(summary,null,2)+'\n');
console.log('\nRingkasan tanpa password/kunci disimpan: '+path.join(groupFolder,'provision-result.json'));
console.log(`Setelah dapat database URL asli, isi FIREBASE_DATABASE_URL pada Script Properties untuk: ${batch.map(x=>x.school_id).join(', ')}.`);
console.log('FIREBASE_CLIENT_EMAIL dan FIREBASE_PRIVATE_KEY juga perlu disetel secara aman; ini tidak otomatis mengelola service account/key.');
